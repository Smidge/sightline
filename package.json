{
  "name": "@smidge/sightline",
  "version": "0.1.3",
  "description": "What's on screen, as text an LLM agent can use. Runs in the page, reads the accessibility tree like a screen reader, never reads typed values.",
  "type": "module",
  "license": "MIT",
  "author": "Harry Smaje",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Smidge/sightline.git"
  },
  "homepage": "https://smidge.github.io/sightline/",
  "bugs": {
    "url": "https://github.com/Smidge/sightline/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "bench": "node bench/run.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "site": "node scripts/site.mjs --serve",
    "site:build": "node scripts/site.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "accessibility",
    "llm",
    "agent",
    "screen-reader",
    "aria",
    "outline",
    "dom",
    "llm-agent",
    "screen-reader-outline"
  ],
  "devDependencies": {
    "esbuild": "^0.25.3",
    "happy-dom": "^20.0.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.32.1"
}
